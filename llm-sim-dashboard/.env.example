# Copy to `.env` and fill in. All values are optional except the OpenAI key
# when using the OpenAI provider.

# ── LLM provider ────────────────────────────────────────────────────────────
# "openai" or "ollama" (also switchable live from the sidebar).
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano
# OPENAI_BASE_URL=            # optional: for Azure / proxies / compatible APIs

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b        # must support tool calling (e.g. llama3.1, qwen2.5)

# ── Simulation backend ───────────────────────────────────────────────────────
# Path to the jax-marl-bc repo. This dashboard lives INSIDE the repo
# (repo/llm-sim-dashboard/), so JMBC_REPO defaults to the parent directory —
# only set it if you move the dashboard elsewhere.
# JMBC_REPO=../jax-marl-bc

# Python interpreter that has jax + jaxmarl + jmbc installed.
# On this machine that is the jax313 conda env:
# JMBC_PYTHON=../miniconda3/envs/jax313/bin/python
