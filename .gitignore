# Python
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/

.local
.local/

paper.pdf

results
results/

# runs/ is generated output only: everything needed to produce a run lives in
# configs/ + jmbc/, so a clone gets the directory (via its README) and nothing
# else -- with one exception. runs/paper-ks-fig34/ is the run behind the paper's
# figures 3 and 4, and ships complete (its own protocol + scripts, plus the full
# record under results/) so those figures can be recomputed without retraining.
runs/*
!runs/README.md
!runs/paper-ks-fig34/
# Re-include the record: the bare `results/` rule further up would swallow it.
!runs/paper-ks-fig34/results/

benchmarks/
.archive/
.sources/

# Colab runners and local notebook scratch: not part of the published repo.
notebooks/
.ipynb_checkpoints/

# Configs the dashboard generates at runtime (configs/exp/dash-*.yaml).
configs/exp/dash-*.yaml

# Baseline timings for a sweep's `reference_csv`: third-party numbers digitized
# from a published figure, kept local. The mechanism is in the sweep schema;
# the data is not ours to redistribute.
configs/reference/

.bal


# Ignore all dotted folders
.*/
